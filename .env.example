# Copy to .env (or set these in your host's environment). Names only; add your own values.
# Never commit a real .env file.

# --- AI provider (one is required for any AI step) ---
# Google AI Studio / Gemini Developer API key (simplest for local use)
GEMINI_API_KEY=
# Vertex AI API key. When set, it wins over GEMINI_API_KEY. Required on Netlify deploys.
VERTEX_API_KEY=
# Optional model overrides
# GEMINI_MODEL_PRIMARY=
# GEMINI_MODEL_FALLBACK=

# --- Required for the server ---
# Random secret, at least 24 characters, used to hash rate-limit identities
ABUSE_HMAC_KEY=
# Optional daily spend cap in USD for model calls (default 15; an invalid value blocks calls)
# DAILY_USD_CAP=
# Optional comma-separated list of origins allowed to POST to /api (default: same origin only)
# ALLOWED_ORIGINS=

# --- Optional voice interviews (Retell) ---
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_GUEST_AGENT_ID=
RETELL_WEBHOOK_KEY=
# Optional voice limits. Leave commented to use defaults.
# SIGNED_IN_MAX_CALL_MINUTES and GUEST_MAX_CALL_MINUTES configure the agent-creation
# script; VOICE_* and GUEST_VOICE_* configure runtime limits. Keep agent and runtime
# per-call caps aligned when overriding them.
# SIGNED_IN_MAX_CALL_MINUTES=
# GUEST_MAX_CALL_MINUTES=
# VOICE_MAX_MINUTES=
# VOICE_DAILY_MINUTES_LIMIT=
# GUEST_VOICE_MAX_MINUTES=
# GUEST_VOICE_CALLS_PER_DAY=
# GUEST_VOICE_DAILY_MINUTES=
# RETELL_LLM_MODEL=

# --- Local dev server and browser scripts ---
# PORT=8888
# DEV_DB=memory
# PLAYWRIGHT_DIR=

# --- Existing Netlify migration history only ---
# Leave unset for a new database. Use only if production already applied
# 023_spend_guard_subject.sql with the SQL now in 024_spend_guard_subject.sql.
# IC_MIGRATION_HISTORY=legacy-spend-23
